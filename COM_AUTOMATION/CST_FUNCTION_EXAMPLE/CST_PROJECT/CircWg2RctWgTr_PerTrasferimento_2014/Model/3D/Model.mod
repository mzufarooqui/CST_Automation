'# MWS Version: Version 2014.3 - Jul 03 2014 - ACIS 23.0.0 -

'# length = mm
'# frequency = GHz
'# time = ns
'# frequency range: fmin = 33 fmax = 50


'@ use template: Filter (Waveguide)

'[VERSION]2013.5|23.0.0|20131122[/VERSION]
' Template for Waveguide Filter' =============================' (CSTxMWSxONLY)' set units to mm, ghzWith Units      .Geometry "mm"      .Frequency "ghz"      .Time "ns" End With ' set background material to pecWith Background      .Type "pec"      .XminSpace "0.0"      .XmaxSpace "0.0"      .YminSpace "0.0"      .YmaxSpace "0.0"      .ZminSpace "0.0"      .ZmaxSpace "0.0" End With ' set boundary conditions to electricWith Boundary     .Xmin "electric"      .Xmax "electric"      .Ymin "electric"      .Ymax "electric"      .Zmin "electric"      .Zmax "electric"      .Xsymmetry "none"      .Ysymmetry "none"      .Zsymmetry "none" End With' increase maximum number of pulses to simulation (resonant structure)' use Online AR FilterWith Solver      .NumberOfPulseWidths "50"      .UseArfilter "True"End With ' optimize mesh for filter structuresWith Mesh      .RatioLimit "20"      .AutomeshRefineAtPecLines "True", "6"End With MeshSettings.SetMeshType "HexTLM" With MeshSettings      .Set "RatioLimitGeometry", "20" End With

'@ define cylinder: CircWg2RctWgTr:CIRCWG_01

'[VERSION]2013.5|23.0.0|20131122[/VERSION]
With Cylinder
	.Reset
	.Name "CIRCWG_01"
	.Component "CircWg2RctWgTr"
	.Material "Vacuum"
	.Axis "Z"
	.Outerradius "wgR"
	.Innerradius "0"
	.Xcenter "0"
	.Ycenter "0"
	.Zcenter "0"
	.Zrange "0", "lIN1"
	.Segments "0"
	.Create
End With

