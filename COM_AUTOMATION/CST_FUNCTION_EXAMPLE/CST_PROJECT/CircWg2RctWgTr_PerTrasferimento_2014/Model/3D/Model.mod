'@ set mesh properties (for backward compatibility)

'[VERSION]2014.3|23.0.0|20140703[/VERSION]
With MeshSettings
     .SetMeshType "Hex"
     .Set "Version", 0%
     .SetMeshType "Srf"
     .Set "Version", 0%
End With

With MeshSettings 
    .SetMeshType "Tet"
    .Set "UseSurfaceMesh3DGradation", False
End With 


